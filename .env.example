# TokenTrim / Lemonade environment variables (all optional — offline preview by default).
# Copy to .env (gitignored) or export in your shell.

# --- TokenTrim Server & Proxy (phase1/server.js) ---
# PORT=7847
# HOST=127.0.0.1

# --- Upstream LLM Provider for Transparent Proxy Mode ---
# When set, requests sent to http://localhost:7847/v1/chat/completions will be
# pruned, enriched, firewalled, and seamlessly forwarded to your upstream provider.
# If omitted, TokenTrim runs in local offline preview mode (zero network).
#
# Examples:
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
#
# Or local Ollama:
# UPSTREAM_BASE_URL=http://localhost:11434/v1
#
# Or Anthropic / OpenRouter:
# UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...

# --- Local Ollama backend (phase0 A/B experiments) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
