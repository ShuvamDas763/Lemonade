# Lemonade environment variables (all optional — the pipeline is offline by default).
# Copy to .env (gitignored) or export in your shell. Nothing here is required for npm test.

# --- Phase 1 detector endpoint (phase1/server.js) ---
# PORT=7847
# Bind address. Loopback by default; set 0.0.0.0 only deliberately (the endpoint echoes input).
# HOST=127.0.0.1

# --- Ollama backends (phase0 A/B experiments, phase2 A/B harness; free/local) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- Anthropic backend (phase0; PAID, also requires an explicit --yes flag) ---
# Provide via your environment/secrets manager, never commit a real key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
